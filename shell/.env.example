# Unified balance fetcher. Run from shell/balance with: go run .
BALANCE_SITE_1_PLATFORM=newapi
BALANCE_SITE_1_NAME=ggniao
BALANCE_SITE_1_URL=https://ggniao.com
BALANCE_SITE_1_USERNAME=you@example.com
BALANCE_SITE_1_PASSWORD=your-password

BALANCE_SITE_2_PLATFORM=sub2api
BALANCE_SITE_2_NAME=ai-input
BALANCE_SITE_2_URL=https://ai.input.im
BALANCE_SITE_2_EMAIL=you@example.com
BALANCE_SITE_2_PASSWORD=your-password

# Single-site legacy format.
# AI_INPUT_BASE_URL=https://ai.input.im
# AI_INPUT_EMAIL=you@example.com
# AI_INPUT_PASSWORD=your-password

# Multi-site format. Add more groups by increasing the number.
AI_INPUT_SITE_1_NAME=main
AI_INPUT_SITE_1_URL=https://ai.input.im
AI_INPUT_SITE_1_EMAIL=you@example.com
AI_INPUT_SITE_1_PASSWORD=your-password

AI_INPUT_SITE_2_NAME=backup
AI_INPUT_SITE_2_URL=https://another.example.com
AI_INPUT_SITE_2_EMAIL=you@example.com
AI_INPUT_SITE_2_PASSWORD=your-password

# NewAPI single-site legacy format.
# NEWAPI_BASE_URL=https://ggniao.com
# NEWAPI_USERNAME=you@example.com
# NEWAPI_PASSWORD=your-password

# NewAPI multi-site format. Add more groups by increasing the number.
NEWAPI_SITE_1_NAME=main
NEWAPI_SITE_1_URL=https://ggniao.com
NEWAPI_SITE_1_USERNAME=you@example.com
NEWAPI_SITE_1_PASSWORD=your-password

NEWAPI_SITE_2_NAME=backup
NEWAPI_SITE_2_URL=https://another-newapi.example.com
NEWAPI_SITE_2_USERNAME=you@example.com
NEWAPI_SITE_2_PASSWORD=your-password
